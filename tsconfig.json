{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "rootDir": ".",
    "types": ["@testing-library/jest-dom"],
    "paths": {
      "@/lib/*": ["./app/_lib/*"],
      "@/components/*": ["./app/_components/*"],
      "@/styles/*": ["./app/_styles/*"],
      "@/assets/*": ["./app/_assets/*"],
      "@/data/*": ["./data/*"],
      "@/public/*": ["./public/*"],
      "@/tests/*": ["./tests/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
